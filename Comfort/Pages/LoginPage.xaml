<Page x:Class="Comfort.Pages.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Comfort.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LoginPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="24" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Candara"
                   Margin="0, 50, 0, 30">
            Вход
        </TextBlock>

        <StackPanel Grid.Row="1"
                    Grid.Column="1" 
                    Margin="0,0,0,20">
            <TextBlock Text="Логин" FontSize="18"/>
            <TextBox x:Name="Login" Margin="0 0 0 20" Height="50" Padding="10" FontSize="18"/>
           


            <TextBlock Text="Пароль" FontSize="18"/>
            <PasswordBox x:Name="Password" Height="50" FontSize="16" Padding="10"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom" Margin="0 220">
            <Button x:Name="EnterBtn" Background="#355CBD" 
                    Foreground="White" Content="Вход" FontSize="18" 
                    Height="50" Margin="0 0 0 10" Click="EnterBtn_Click"/>
            <Button x:Name="RegistrBtn" Background="White" 
         Foreground="#355CBD" Content="Регистрация" FontSize="18" 
         Height="50" Margin="0 0 0 10" Click="RegistrBtn_Click"/>
        </StackPanel>
    </Grid>
</Page>
